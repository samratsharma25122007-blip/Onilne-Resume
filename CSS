
/* =================================
   GENERAL STYLING
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #0b1120;
    color: #e5e7eb;
    font-family: 'Inter', sans-serif;
    line-height: 1.7;
}

:root {
    --background: #0b1120;
    --surface: #111c30;
    --accent: #38bdf8;
    --text: #e5e7eb;
    --muted: #94a3b8;
}


/* =================================
   NAVIGATION BAR
================================= */

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 9%;
    background: #0b1120;
    border-bottom: 1px solid #1e293b;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    color: white;
    text-decoration: none;
}

.logo span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: var(--muted);
    font-size: 14px;
    transition: 0.3s;
}

.nav-links a:hover {
    color: var(--accent);
}

.nav-links .contact-btn {
    border: 1px solid var(--accent);
    padding: 9px 17px;
    border-radius: 7px;
    color: var(--accent);
}


/* =================================
   HERO SECTION
================================= */

.hero {
    min-height: 590px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 90px 12%;
    gap: 50px;
    background:
        radial-gradient(circle at 80% 40%,
        #16314c 0%, #0b1120 55%);
}

.hero-content {
    max-width: 650px;
}

.eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.15;
    margin-bottom: 20px;
    color: white;
}

.hero h1 span {
    color: var(--accent);
}

.hero h2 {
    font-size: 21px;
    font-weight: 500;
    color: #cbd5e1;
    margin-bottom: 20px;
}

.hero-description {
    color: var(--muted);
    max-width: 560px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: 0.3s;
}

.primary-btn {
    background: var(--accent);
    color: #07111f;
}

.primary-btn:hover {
    background: #7dd3fc;
    transform: translateY(-3px);
}

.secondary-btn {
    border: 1px solid #475569;
    color: white;
}

.secondary-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
}


/* =================================
   PROFILE CARD
================================= */

.hero-card {
    text-align: center;
    background: rgba(17, 28, 48, 0.85);
    border: 1px solid #263b55;
    border-radius: 18px;
    padding: 35px;
    width: 260px;
    flex-shrink: 0;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

.profile-placeholder {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: linear-gradient(135deg, #38bdf8, #2563eb);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 36px;
    font-weight: 800;
    color: white;
    margin: 0 auto 20px;
}

.hero-card h3 {
    color: white;
    margin-bottom: 5px;
}

.hero-card p {
    color: var(--muted);
    font-size: 13px;
}

.status {
    margin-top: 20px;
    color: #86efac;
    font-size: 11px;
}

.status span {
    display: inline-block;
    background: #22c55e;
    height: 7px;
    width: 7px;
    border-radius: 50%;
    margin-right: 5px;
}


/* =================================
   COMMON SECTIONS
================================= */

.section {
    padding: 85px 12%;
}

.alternate {
    background: #101a2c;
}

.section-heading {
    margin-bottom: 40px;
}

.section-heading h2 {
    font-size: 36px;
    color: white;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 50px;
}

.about-content h3 {
    font-size: 25px;
    color: white;
    line-height: 1.5;
}

.about-content p {
    color: var(--muted);
    margin-bottom: 15px;
}


/* =================================
   EDUCATION & PROJECT CARDS
================================= */

.card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.info-card {
    background: var(--surface);
    border: 1px solid #26364d;
    padding: 30px;
    border-radius: 12px;
    transition: 0.3s;
}

.info-card:hover,
.experience-card:hover,
.skill-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
}

.card-number {
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
}

.info-card h3 {
    color: white;
    margin: 15px 0 8px;
    font-size: 20px;
}

.card-subtitle {
    color: var(--accent) !important;
}

.info-card p {
    color: var(--muted);
    font-size: 14px;
}

.tag {
    display: inline-block;
    background: #18324a;
    color: #7dd3fc;
    padding: 5px 12px;
    border-radius: 20px;
    margin-top: 18px;
    font-size: 11px;
}


/* =================================
   EXPERIENCE
================================= */

.experience-list {
    display: grid;
    gap: 18px;
}

.experience-card {
    background: var(--surface);
    border: 1px solid #26364d;
    padding: 28px;
    border-radius: 12px;
    transition: 0.3s;
}

.experience-top {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    flex-wrap: wrap;
}

.experience-top h3 {
    color: white;
}

.experience-top span {
    color: var(--accent);
    font-size: 12px;
}

.company {
    color: var(--accent) !important;
    margin: 5px 0 12px;
}

.experience-card p {
    color: var(--muted);
    font-size: 14px;
}


/* =================================
   SKILLS
================================= */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background: var(--surface);
    padding: 25px;
    border: 1px solid #26364d;
    border-radius: 12px;
    transition: 0.3s;
}

.skill-card h3 {
    color: white;
    margin-bottom: 20px;
    font-size: 17px;
}

.skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.skill-tags span {
    background: #1e314a;
    color: #bae6fd;
    padding: 7px 12px;
    border-radius: 6px;
    font-size: 12px;
}


/* =================================
   PROJECTS
================================= */

.project-label {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: 700;
}

.project-card h3 {
    margin-top: 20px;
}


/* =================================
   CONTACT
================================= */

.contact-section {
    text-align: center;
    padding: 100px 20px;
    background: radial-gradient(circle,
    #173451 0%, #0b1120 70%);
}

.contact-section h2 {
    font-size: 36px;
    color: white;
    margin-bottom: 15px;
}

.contact-section p {
    color: var(--muted);
    max-width: 550px;
    margin: 0 auto 30px;
}


/* =================================
   FOOTER
================================= */

footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 10%;
    background: #080e19;
    color: var(--muted);
    font-size: 12px;
}

footer a {
    color: var(--accent);
    text-decoration: none;
}


/* =================================
   RESPONSIVE DESIGN
================================= */

@media (max-width: 900px) {

    .navbar {
        padding: 20px 5%;
    }

    .nav-links {
        gap: 13px;
    }

    .hero {
        padding: 70px 7%;
    }

    .section {
        padding: 70px 7%;
    }

    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 650px) {

    .navbar {
        flex-direction: column;
        gap: 18px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        flex-direction: column;
        text-align: center;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-card {
        width: 100%;
        max-width: 300px;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .card-grid,
    .skills-grid {
        grid-template-columns: 1fr;
    }

    .section-heading h2 {
        font-size: 29px;
    }

    footer {
        flex-direction: column;
        gap: 12px;
        text-align: center;
    }
}
